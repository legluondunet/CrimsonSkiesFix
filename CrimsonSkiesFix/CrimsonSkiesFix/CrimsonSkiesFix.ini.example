; CrimsonSkiesFix configuration TEMPLATE (not auto-loaded; copy only if desired).
; The DLL creates CrimsonSkiesFix.ini on first launch if it does not exist.
; This template remains .example so extracting future updates never replaces your settings.
[Graphics]
Borderless=1
DesktopResolution=1
FPSLimit=60
; Experimental: throttle only primary modern Flip; not Blt or Unlock.
; Leave at 0 until a diagnostic log confirms the desired rendering path.
ModernFPSPacing=0
; FPSLimit is clamped to 1..60.

[Debug]
; 0 = no CrimsonSkiesFix.log is created beside ddraw.dll.
; 1 = write CrimsonSkiesFix.log beside ddraw.dll.
Log=0
; Optional: passive surface-method audit, requires Log=1. No graphic changes.
SurfaceUsageTrace=0
