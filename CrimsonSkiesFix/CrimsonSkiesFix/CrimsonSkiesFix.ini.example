; CrimsonSkiesFix user-settings TEMPLATE (not loaded automatically).
; The DLL creates CrimsonSkiesFix/CrimsonSkiesFix.ini on first launch.
; Updates ship only this .example so existing user settings remain unchanged.
[Graphics]
Borderless=1
DesktopResolution=1
FPSLimit=60
; Original experimental DirectDraw4 pacing; disabled by default.
ModernFPSPacing=0
; Native 3D adapter and FOV/HUD adaptation; opt in explicitly.
ExperimentalWindowedAdapter=0
Native3DWidescreen=0
; Optional focus/window erase/menu color corrections; disabled by default.
FocusRepaint=0
WindowEraseGuard=0
LegacyOffscreenRGB565=0
; Native GOS Video Graphics/Resolution dropdown disable:
; off = never modify GOS archives, including preexisting overrides.
; on = install or recognize a verified, backed-up crimptch.rof override.
; restore = restore the exact saved original archive on next game launch;
;           then change this setting back to off or on.
; Requires ExperimentalWindowedAdapter=1, Native3DWidescreen=1
; and DesktopResolution=1 when set to on.
; Install, repeat launch and restoration tested on Wine/GE-Proton.
; Native Windows gameplay testing remains deferred.
GosVideoLock=off

[Debug]
; Ordinary logging disabled by default; EXE admission failures still logged.
; Some experimental adapter diagnostics may also be logged automatically.
Log=0
SurfaceUsageTrace=0
CrashBltTrace=0
ColorProbe=0
ColorCapture=0
