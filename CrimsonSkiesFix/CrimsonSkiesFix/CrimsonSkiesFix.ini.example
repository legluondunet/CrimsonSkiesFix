; CrimsonSkiesFix user-settings TEMPLATE (not loaded automatically).
; The DLL creates CrimsonSkiesFix/CrimsonSkiesFix.ini on first launch.
; Updates ship only this .example so existing user settings remain unchanged.
[Graphics]
Borderless=1
DesktopResolution=1
FPSLimit=60
; Original experimental DirectDraw4 pacing; disabled by default.
ModernFPSPacing=0
; Enabled by default: validated native 3D adapter, widescreen FOV/HUD
; and suppression of the obsolete startup resolution/driver dialog.
; Disable Native3DWidescreen to disable the prompt bypass.
ExperimentalWindowedAdapter=1
Native3DWidescreen=1
; First-run focus recovery and white-background prevention enabled.
; FocusRepaint performs one-shot full repaint after focus/paint changes.
; WindowEraseGuard suppresses WM_ERASEBKGND on the verified game window.
; Set either to 0 to disable that mechanism independently.
FocusRepaint=1
WindowEraseGuard=1
; First-image/legacy artwork RGB565 color correction is enabled by default.
; Only exact-matching 800x600 16bpp legacy offscreen creation is affected.
; Set to 0 to opt out.
LegacyOffscreenRGB565=1
; Enabled by default: GameOS native Graphics and Resolution dropdown
; disable (greyed out and unselectable), including the mode-change guards.
; On first launch this modifies ONLY GOSDATA/ASSETS/crimptch.rof;
; its original contents are saved to an exclusive *.original.bak file.
; on = install or recognize the verified, backed-up GOS override.
; off = never modify GOS archives; does NOT undo an installed patch.
; restore = restore the original from its backup on next game launch;
;           then change this option to off (or on to re-enable).
; Requires ExperimentalWindowedAdapter=1, Native3DWidescreen=1 and
; DesktopResolution=1. Unknown original assets fail closed.
; Windows 11 and GE-Proton owner test sessions passed; new PCs may differ.
GosVideoLock=on

[Compatibility]
; Enabled by default under Wine only, for the exact verified ROFFILE.DLL SHA-256.
; Pads native INI text allocations with two NUL bytes to avoid a crash at
; roffile+0x22e0. Changes memory only, never the DLL on disk.
; Requires ROFFILE to be loaded before the next DirectDraw render hook.
; Set to 0 to opt out; never installed on native Windows.
RoffileTerminatorFix=1

[Debug]
; Ordinary logging disabled by default; EXE admission failures still logged.
; Some experimental adapter diagnostics may also be logged automatically.
Log=0
; Diagnostic only: postpone the in-memory FOV/HUD patch to DD4 negotiation.
; Keep 0 normally; use 1 for one native Windows startup A/B test.
DeferEarlyNativePatch=0
; Native Windows automatically reads physical monitor pixels (e.g. 1920x1200)
; even if the legacy game sees DPI-virtualized 1536x960 coordinates.
; Diagnostic only: set 1 to also force this physical-pixel mode under Wine/Proton.
; Keep 0 in regular use. DeferEarlyNativePatch=1 takes precedence.
EarlyNativePhysicalMode=0
; Experimental native Windows ONLY: opt into SYSTEM DPI awareness before first window.
; Helps isolate 125% DPI clipping of physical 1920x1200 gameplay and focus loss.
; Changes the process DPI mode for this launch; may regress some old UI.
; Keep 0 by default, always 0 on Wine/Proton.
NativeDpiAware=0
; EXPERIMENTAL Windows-native A/B: attach the game's verified real DD4
; owner before its first mode switch, enabling windowed DirectDraw preflight.
; Tested in-game under Windows 11 with the exact opt-in compatibility profile.
; Requires ExperimentalWindowedAdapter=1, Native3DWidescreen=1, Log=1.
; Uses an in-memory exact-EXE entrypoint hook; original game file unchanged.
; Keep 0 normally. Never active on Wine/Proton.
NativeDD4Bootstrap=0
; Native Win11/DirectShow A/B: use a real 32-bit XRGB backbuffer for 800x600
; video and menus instead of real RGB565 plus software movie conversion.
; Virtual game mode remains logically 800x600x16; primary CPU Lock is RGB565.
; Requires NativeDD4Bootstrap=1; never used on Wine/Proton.
; Visually validated by the owner under Windows 11 using the explicit test profile.
; Still disabled on fresh installs pending a general default-profile test.
NativeMovieRGB32=0
; Experimental Windows-only UI responsiveness investigation.
; On each native RGB32 intro/menu Flip, after the DirectDraw presentation
; lock has been released, dispatch at most 4 queued messages for the exact
; verified game HWND on its owner thread. Nested pumps are suppressed.
; Never runs in Wine/Proton or normal gameplay; opt-in only.
; Keep 0 unless explicitly diagnosing Windows "Not Responding".
NativeMovieMessagePump=0
; Native Windows-only 800x600 MainMenu/Preferences A/B: remap only the
; game's WM_MOUSEMOVE and mouse button client coordinates to the centered
; 4:3 canvas (e.g. 1536x960 window -> centered 1280x960 -> 800x600).
; Real OS pointer, DirectInput, all keys, videos and 1920x1200 gameplay
; remain untouched. Requires verified RGB32 movie graph and WndProc guard.
; Disabled by default; test separately from NativeMovieMessagePump.
NativeMenuMouseRemap=0
; Native Windows 800x600 movie/menu A/B: the original game can leave
; ClipCursor restricted to its small pre-borderless window even after
; the verified HWND grows to the entire monitor.
; When the OS clip exactly matches the game's traced stale request,
; expand it to the verified HWND client rectangle, with readback check.
; Does NOT show the Windows cursor or modify input coordinates.
; Test with NativeMenuMouseRemap=0 to isolate this single change.
NativeMouseClipRepair=0
; DIAGNOSTIC Windows-native 800x600 MainMenu/Preferences only:
; Display the standard Windows arrow after the original game WndProc,
; on mouse movement, without changing coordinates or game input.
; Used to distinguish a hidden Windows pointer from missing game cursor.
; Requires NativeDD4Bootstrap, NativeMovieRGB32, WindowEraseGuard;
; NativeMenuMouseRemap MUST be 0. NEVER enabled by default.
; Restores our own ShowCursor count on leaving menu / switching modes.
NativeSystemCursorProbe=0
; Native Windows / Debug ONLY: passive DirectInput mouse device trace.
; Reports GUID_SysMouse CreateDevice, SetCooperativeLevel, Acquire,
; SetDataFormat, GetDeviceState and GetDeviceData HRESULT and counters.
; Exact game EXE DirectInputCreateA IAT, original calls forwarded unchanged.
; Requires Log=1 + NativeDD4Bootstrap=1. No cursor movement or click injection.
; OFF by default; never active on Wine/Proton.
NativeDirectInputMouseTrace=0
; Native Windows ONLY: opt-in DirectInput system mouse cooperative repair.
; The admitted game requests DISCL_EXCLUSIVE | DISCL_BACKGROUND (0x9),
; which DirectInput rejects on system mouse with E_NOTIMPL (0x80004001).
; Replace precisely that call with DISCL_NONEXCLUSIVE | DISCL_FOREGROUND
; (0x6), forward native COM result; no virtual mouse, emulation or DPI
; changes. Requires Log=1 + NativeDD4Bootstrap=1. OFF by default.
; Does not apply to Wine/Proton, keyboard, controllers or gameplay remap.
NativeDirectInputMouseCoopRepair=0
; DIAGNOSTIC native Windows MainMenu/Preferences + post-gameplay ESC pause UI original GOS cursor bridge.
; The Win11 dumps show mouse x=799,y=599 (lower-right clamp) while the
; 800x600 menu is presented centered in a 1536x960 logical HWND. This
; keeps the ORIGINAL game cursor renderer and mouse buttons intact,
; adjusting only GUID_SysMouse DirectInput relative dx/dy to the same
; 4:3 viewport transformation as rendered menu. No fabricated clicks.
; Requires NativeDD4Bootstrap=1, NativeMovieRGB32=1,
; NativeDirectInputMouseCoopRepair=1, WindowEraseGuard=1, Log=1.
; Keep NativeMenuMouseRemap=0 and NativeSystemCursorProbe=0 for isolation.
; Also handles the 800x600 pause interface reached DIRECTLY from verified
; native 3D gameplay after the original MainMenu was observed. The intro
; movie phase is excluded; 3D flight input is never remapped.
; Windows only; OFF by default, no Wine/Proton/gameplay modifications.
NativeGosCursorBridge=0
; Windows-native XRGB8888 800x600 menu/movie: compose black background
; and centered aspect-correct 4:3 image on one full-window offscreen
; DirectDraw surface, then one complete primary Blt per frame.
; No side-rectangle color fills, no GDI, native 3D remains unmodified.
; Output dimensions follow current Win32 game HWND client, including DPI.
; Wine/Proton never use this experiment. Driver errors fall back to the
; previous validated DirectDraw mode. Default OFF, Debug A/B only.
NativeFullFrameCompose=0
SurfaceUsageTrace=0
CrashBltTrace=0
; Passive, opt-in successful virtual DD4 Flip spacing over batches of 120 frames.
; Reports p50/p95/p99, >2x/>3x target intervals and presentation-call duration.
; Not on-screen swap/present timestamps; requires [Debug] Log=1.
FrameTimeTrace=0
