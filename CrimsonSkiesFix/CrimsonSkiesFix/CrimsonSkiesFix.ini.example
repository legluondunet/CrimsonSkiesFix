; CrimsonSkiesFix user-settings TEMPLATE (not loaded automatically).
; The DLL creates CrimsonSkiesFix/CrimsonSkiesFix.ini on first launch.
; Updates ship only this .example so existing user settings remain unchanged.
[Graphics]
Borderless=1
DesktopResolution=1
FPSLimit=60
; Original experimental DirectDraw4 pacing; disabled by default.
ModernFPSPacing=0
; Enabled by default: validated native 3D adapter, widescreen FOV/HUD
; and suppression of the obsolete startup resolution/driver dialog.
; Disable Native3DWidescreen to disable the prompt bypass.
ExperimentalWindowedAdapter=1
Native3DWidescreen=1
; First-run focus recovery and white-background prevention enabled.
; FocusRepaint performs one-shot full repaint after focus/paint changes.
; WindowEraseGuard suppresses WM_ERASEBKGND on the verified game window.
; Set either to 0 to disable that mechanism independently.
FocusRepaint=1
WindowEraseGuard=1
; First-image/legacy artwork RGB565 color correction is enabled by default.
; Only exact-matching 800x600 16bpp legacy offscreen creation is affected.
; Set to 0 to opt out.
LegacyOffscreenRGB565=1
; Enabled by default: GameOS native Graphics and Resolution dropdown
; disable (greyed out and unselectable), including the mode-change guards.
; On first launch this modifies ONLY GOSDATA/ASSETS/crimptch.rof;
; its original contents are saved to an exclusive *.original.bak file.
; on = install or recognize the verified, backed-up GOS override.
; off = never modify GOS archives; does NOT undo an installed patch.
; restore = restore the original from its backup on next game launch;
;           then change this option to off (or on to re-enable).
; Requires ExperimentalWindowedAdapter=1, Native3DWidescreen=1 and
; DesktopResolution=1. Unknown original assets fail closed.
; Wine/GE-Proton owner tests passed; Windows gameplay test deferred.
GosVideoLock=on

[Compatibility]
; Enabled by default under Wine only, for the exact verified ROFFILE.DLL SHA-256.
; Pads native INI text allocations with two NUL bytes to avoid a crash at
; roffile+0x22e0. Changes memory only, never the DLL on disk.
; Requires ROFFILE to be loaded before the next DirectDraw render hook.
; Set to 0 to opt out; never installed on native Windows.
RoffileTerminatorFix=1

[Debug]
; Ordinary logging disabled by default; EXE admission failures still logged.
; Some experimental adapter diagnostics may also be logged automatically.
Log=0
; Diagnostic only: postpone the in-memory FOV/HUD patch to DD4 negotiation.
; Keep 0 normally; use 1 for one native Windows startup A/B test.
DeferEarlyNativePatch=0
; Native Windows automatically reads physical monitor pixels (e.g. 1920x1200)
; even if the legacy game sees DPI-virtualized 1536x960 coordinates.
; Diagnostic only: set 1 to also force this physical-pixel mode under Wine/Proton.
; Keep 0 in regular use. DeferEarlyNativePatch=1 takes precedence.
EarlyNativePhysicalMode=0
SurfaceUsageTrace=0
CrashBltTrace=0
ColorProbe=0
ColorCapture=0
