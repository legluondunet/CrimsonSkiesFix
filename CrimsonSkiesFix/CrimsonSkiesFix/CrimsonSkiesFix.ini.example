; CrimsonSkiesFix user-settings TEMPLATE (not loaded automatically).
; The DLL creates CrimsonSkiesFix/CrimsonSkiesFix.ini on first launch.
; Compatibility and stability fixes are automatic; no switches needed.
; Existing user INI files are never overwritten by updates.

[Graphics]
; Frame rate limit (1 to 60 FPS).
FPSLimit=60

[Debug]
; Optional diagnostics: 1 enables logging, 0 disables it.
; Logging does not control game compatibility fixes.
Log=0
