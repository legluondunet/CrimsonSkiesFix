; Split WinMM loader ONLY - fail-closed export table for ordinal clients.
; Names are preserved; the 185 named exports occupy @2048..@2232.
; Ordinals @1..@1023 are intentionally EMPTY: the original Wine/Windows
; WinMM DLLs assign conflicting numbers to functions. In particular,
; @11 does NOT mean the same multimedia API on every platform.
; A third-party ordinal import must fail loading explicitly rather than
; dispatch to a different, ABI-incompatible function. This does NOT
; implement correct ordinal forwarding or solve loader-lock hazards.
; Do not reuse this map for runtime-winmm (monolithic experimental target).
LIBRARY winmm.dll
EXPORTS
    mixerGetLineInfoA=crimson_winmm_forward_0 @2048
    mixerOpen=crimson_winmm_forward_1 @2049
    mciGetErrorStringA=crimson_winmm_forward_2 @2050
